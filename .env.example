# Storage backend: "s3" (S3 / MinIO) or "local" (keys map to files under LOCAL_STORAGE_DIR)
STORAGE=s3
LOCAL_STORAGE_DIR=./.storage

# S3 / MinIO (local defaults match invai-infra/local/docker-compose.yml)
S3_BUCKET=invai-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=invai
S3_SECRET_ACCESS_KEY=invai-secret
# Create S3_BUCKET at startup when it is missing
S3_CREATE_BUCKET=true

# Scratch directory for downloads and big renders (default: system temp; a 240in sheet needs ~1 GB)
TMP_DIR=
